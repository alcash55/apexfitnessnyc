# Learning template only. Copy to frontend/.env.local and fill privately.
# Start with an isolated Supabase development project or local stack.
# See ../docs/learning/01-supabase-auth.md before using the owner's project.

# Public auth configuration. Both URLs below must identify the same environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged database access. Never add NEXT_PUBLIC_ to this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner-authorized Stripe sandbox/test configuration for learning.
STRIPE_SECRET_KEY=
# Use the local Stripe CLI listener's secret locally; deployed endpoints differ.
STRIPE_WEBHOOK_SECRET=

# Explicit local return/canonical origin. Use the approved HTTPS origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional existing features. Leave blank unless intentionally configured.
NEXT_PUBLIC_BOOKING_URL=
DISCORD_CONTACT_WEBHOOK_URL=
